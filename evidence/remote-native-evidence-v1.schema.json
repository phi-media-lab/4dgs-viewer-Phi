{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phi:4dgs:remote-native:evidence:v1",
  "title": "Remote-native 4DGS reference and comparison evidence v1",
  "description": "Strict structural contract for the reference and comparison receipts emitted by phi-4dgs-player.",
  "oneOf": [
    { "$ref": "#/$defs/referenceReceipt" },
    { "$ref": "#/$defs/comparisonReceipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "rgbNumber": {
      "type": "number",
      "minimum": 0,
      "maximum": 255
    },
    "rgbDelta": {
      "type": "number",
      "minimum": -255,
      "maximum": 255
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_version",
        "rust_toolchain",
        "git_commit",
        "native_source_sha256",
        "shader_bundle_sha256",
        "client_build"
      ],
      "properties": {
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "rust_toolchain": {
          "type": "string",
          "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+|nightly-[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "git_commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            { "type": "null" }
          ]
        },
        "native_source_sha256": { "$ref": "#/$defs/sha256" },
        "shader_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "client_build": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "manifest_sha256",
        "geometry_sha256",
        "appearance_sha256"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "geometry_sha256": { "$ref": "#/$defs/sha256" },
        "appearance_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "visible",
        "invalid",
        "culled_temporal",
        "culled_frustum",
        "culled_footprint",
        "equal_depth",
        "tile_overlaps",
        "tile_overflow",
        "max_tile_load",
        "early_terminated_pixels",
        "pixel_splat_tests",
        "budget_limited_pixels",
        "max_pixel_splat_tests",
        "max_budget_remaining_transmittance",
        "persistent_workload_flags"
      ],
      "properties": {
        "active": { "$ref": "#/$defs/u32" },
        "visible": { "$ref": "#/$defs/u32" },
        "invalid": { "$ref": "#/$defs/u32" },
        "culled_temporal": { "$ref": "#/$defs/u32" },
        "culled_frustum": { "$ref": "#/$defs/u32" },
        "culled_footprint": { "$ref": "#/$defs/u32" },
        "equal_depth": { "$ref": "#/$defs/u32" },
        "tile_overlaps": { "$ref": "#/$defs/u32" },
        "tile_overflow": { "$ref": "#/$defs/u32" },
        "max_tile_load": { "$ref": "#/$defs/u32" },
        "early_terminated_pixels": { "$ref": "#/$defs/u32" },
        "pixel_splat_tests": { "$ref": "#/$defs/u32" },
        "budget_limited_pixels": { "$ref": "#/$defs/u32" },
        "max_pixel_splat_tests": { "$ref": "#/$defs/u32" },
        "max_budget_remaining_transmittance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "persistent_workload_flags": { "$ref": "#/$defs/u32" }
      }
    },
    "dmabuf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drm_fourcc",
        "drm_fourcc_name",
        "modifier",
        "modifier_hex",
        "candidate_modifiers",
        "modifier_selection_policy",
        "plane_count",
        "offset",
        "stride",
        "allocation_bytes"
      ],
      "properties": {
        "drm_fourcc": { "$ref": "#/$defs/u32" },
        "drm_fourcc_name": { "type": "string", "minLength": 1 },
        "modifier": { "$ref": "#/$defs/u64" },
        "modifier_hex": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        },
        "candidate_modifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{16}$"
          }
        },
        "modifier_selection_policy": { "type": "string", "minLength": 1 },
        "plane_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "offset": { "$ref": "#/$defs/u64" },
        "stride": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "allocation_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "permutationScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_order", "sse", "psnr_db"],
      "properties": {
        "reference_order": {
          "enum": ["RGB", "RBG", "GRB", "GBR", "BRG", "BGR"]
        },
        "sse": { "$ref": "#/$defs/u64" },
        "psnr_db": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "rgbNumbers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/rgbNumber" }
    },
    "rgbDeltas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/rgbDelta" }
    },
    "rgbBytes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/u8" }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_memory",
        "input_format",
        "drm_memory_bytes_little_endian",
        "appsrc_colorimetry",
        "nv12_colorimetry",
        "nv12_chroma_site",
        "h264_caps",
        "color_conversion",
        "reference_importer",
        "reference_width",
        "reference_height",
        "reference_rgba_bytes",
        "reference_rgba_sha256",
        "decoded_rgba_bytes",
        "decoded_rgba_sha256",
        "encoder",
        "decoder",
        "codec",
        "h264_sps_vui_color_description",
        "display_color_contract",
        "bitrate_kbps",
        "target_usage",
        "video_slices",
        "b_frames",
        "encoded_bytes",
        "encode_ms",
        "decode_ms",
        "decoded_rgb_mae",
        "reference_rgb_mean",
        "decoded_rgb_mean",
        "decoded_rgb_mean_delta",
        "decoded_rgb_max_abs",
        "permutation_scores",
        "best_permutation",
        "pixel_gate_passed",
        "cpu_pixel_copy",
        "validation_cpu_readback"
      ],
      "properties": {
        "input_memory": { "const": "DMA-BUF" },
        "input_format": { "type": "string", "minLength": 1 },
        "drm_memory_bytes_little_endian": { "type": "string", "minLength": 1 },
        "appsrc_colorimetry": { "type": "string", "minLength": 1 },
        "nv12_colorimetry": { "type": "string", "minLength": 1 },
        "nv12_chroma_site": { "type": "string", "minLength": 1 },
        "h264_caps": { "type": "string", "minLength": 1 },
        "color_conversion": { "type": "string", "minLength": 1 },
        "reference_importer": { "type": "string", "minLength": 1 },
        "reference_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "reference_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "reference_rgba_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reference_rgba_sha256": { "$ref": "#/$defs/sha256" },
        "decoded_rgba_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "decoded_rgba_sha256": { "$ref": "#/$defs/sha256" },
        "encoder": { "type": "string", "minLength": 1 },
        "decoder": { "type": "string", "minLength": 1 },
        "codec": { "type": "string", "minLength": 1 },
        "h264_sps_vui_color_description": { "type": "string", "minLength": 1 },
        "display_color_contract": { "type": "string", "minLength": 1 },
        "bitrate_kbps": { "$ref": "#/$defs/u32" },
        "target_usage": { "$ref": "#/$defs/u32" },
        "video_slices": { "$ref": "#/$defs/u32" },
        "b_frames": { "$ref": "#/$defs/u32" },
        "encoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "encode_ms": { "$ref": "#/$defs/nonNegativeNumber" },
        "decode_ms": { "$ref": "#/$defs/nonNegativeNumber" },
        "decoded_rgb_mae": { "$ref": "#/$defs/rgbNumbers" },
        "reference_rgb_mean": { "$ref": "#/$defs/rgbNumbers" },
        "decoded_rgb_mean": { "$ref": "#/$defs/rgbNumbers" },
        "decoded_rgb_mean_delta": { "$ref": "#/$defs/rgbDeltas" },
        "decoded_rgb_max_abs": { "$ref": "#/$defs/rgbBytes" },
        "permutation_scores": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permutationScore" }
        },
        "best_permutation": {
          "enum": ["RGB", "RBG", "GRB", "GBR", "BRG", "BGR"]
        },
        "pixel_gate_passed": { "const": true },
        "cpu_pixel_copy": { "const": false },
        "validation_cpu_readback": { "const": true }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "backend",
        "driver",
        "driver_info",
        "shader_bundle_sha256",
        "width",
        "height",
        "time",
        "submit_wait_ms",
        "counters",
        "dmabuf",
        "media"
      ],
      "properties": {
        "adapter": { "type": "string" },
        "backend": { "type": "string", "minLength": 1 },
        "driver": { "type": "string" },
        "driver_info": { "type": "string" },
        "shader_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "time": { "type": "number", "minimum": 0, "maximum": 1 },
        "submit_wait_ms": { "$ref": "#/$defs/nonNegativeNumber" },
        "counters": { "$ref": "#/$defs/counters" },
        "dmabuf": { "$ref": "#/$defs/dmabuf" },
        "media": { "$ref": "#/$defs/media" }
      }
    },
    "referenceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgba8_bytes", "rgba8_sha256", "review_status"],
      "properties": {
        "rgba8_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "rgba8_sha256": { "$ref": "#/$defs/sha256" },
        "review_status": {
          "enum": ["UNREVIEWED", "REVIEWED", "REJECTED"]
        }
      }
    },
    "imageMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "min_psnr_db",
        "max_allowed_abs",
        "exact_match",
        "psnr_db",
        "max_abs",
        "mean_abs",
        "golden_sha256",
        "actual_sha256",
        "pass"
      ],
      "properties": {
        "policy": { "enum": ["reference-parity", "motion-preview"] },
        "min_psnr_db": { "$ref": "#/$defs/nonNegativeNumber" },
        "max_allowed_abs": { "$ref": "#/$defs/u8" },
        "exact_match": { "type": "boolean" },
        "psnr_db": {
          "oneOf": [
            { "$ref": "#/$defs/nonNegativeNumber" },
            { "type": "null" }
          ]
        },
        "max_abs": { "$ref": "#/$defs/u8" },
        "mean_abs": { "$ref": "#/$defs/rgbNumber" },
        "golden_sha256": { "$ref": "#/$defs/sha256" },
        "actual_sha256": { "$ref": "#/$defs/sha256" },
        "pass": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "policy": { "const": "reference-parity" } },
            "required": ["policy"]
          },
          "then": {
            "properties": {
              "min_psnr_db": { "const": 24 },
              "max_allowed_abs": { "const": 96 }
            }
          },
          "else": {
            "properties": {
              "min_psnr_db": { "const": 30 },
              "max_allowed_abs": { "const": 128 }
            }
          }
        },
        {
          "if": {
            "properties": { "exact_match": { "const": true } },
            "required": ["exact_match"]
          },
          "then": {
            "properties": {
              "psnr_db": { "type": "null" },
              "max_abs": { "const": 0 },
              "mean_abs": { "const": 0 }
            }
          },
          "else": {
            "properties": {
              "psnr_db": { "$ref": "#/$defs/nonNegativeNumber" }
            }
          }
        }
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_gpu_api",
        "gpu_to_cpu_readback",
        "render_target",
        "exported_handle",
        "note"
      ],
      "properties": {
        "browser_gpu_api": { "const": "none" },
        "gpu_to_cpu_readback": { "const": "validation-only" },
        "render_target": { "type": "string", "minLength": 1 },
        "exported_handle": { "const": "DMA-BUF fd" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "referenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "renderer",
        "source",
        "asset",
        "frame",
        "reference"
      ],
      "properties": {
        "schema": { "const": "phi.4dgs.remote-native.reference.v1" },
        "stage": { "const": "native-vulkan-dmabuf-vaapi" },
        "renderer": { "const": "Rust/wgpu/WGSL/Vulkan" },
        "source": { "$ref": "#/$defs/source" },
        "asset": { "$ref": "#/$defs/asset" },
        "frame": { "$ref": "#/$defs/frame" },
        "reference": { "$ref": "#/$defs/referenceImage" }
      }
    },
    "comparisonReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "renderer",
        "source",
        "asset",
        "frame",
        "image",
        "transport"
      ],
      "properties": {
        "schema": { "const": "phi.4dgs.remote-native.receipt.v1" },
        "stage": { "const": "native-vulkan-dmabuf-vaapi" },
        "renderer": { "const": "Rust/wgpu/WGSL/Vulkan" },
        "source": { "$ref": "#/$defs/source" },
        "asset": { "$ref": "#/$defs/asset" },
        "frame": { "$ref": "#/$defs/frame" },
        "image": { "$ref": "#/$defs/imageMetrics" },
        "transport": { "$ref": "#/$defs/transport" }
      }
    }
  }
}
